# ===============================
# 数据库连接配置
# ===============================

# 本地数据库模式（docker-compose.local.yml）
POSTGRES_USER=magicnav
POSTGRES_PASSWORD=magicnavPOSTGRESpassword
POSTGRES_DB=magicnav
POSTGRES_PORT=5432

# 数据库连接 URL
# 本地模式默认值 / 远程模式请替换为完整 URL
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# NextAuth配置
NEXTAUTH_SECRET="[YOUR_NEXTAUTH_SECRET]"
NEXTAUTH_URL="http://localhost:3000"

# 管理员配置
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin123"

# 网站配置
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# logo.dev API Key (可选)
LOGO_DEV_API_KEY="[YOUR_LOGO_DEV_API_KEY]"
