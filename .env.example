# ===============================
# 数据库连接配置
# ===============================

# 本地数据库模式（使用 docker-compose.local.yml）
# - 直接使用下面的默认配置
# - 会自动生成数据库密码，也可以手动指定
POSTGRES_USER="magicnav"
POSTGRES_PASSWORD="[YOUR_DB_PASSWORD]"
POSTGRES_DB="magicnav"
POSTGRES_PORT="5432"

# 数据库连接URL
# - 本地模式：默认使用上面的 POSTGRES_* 参数自动拼接
# - 远程模式：将下面的值替换为远程数据库的完整连接URL
#   远程模式示例：DATABASE_URL="postgresql://username:password@hostname:port/database?schema=public"
#   远程模式下可以忽略上面的 POSTGRES_* 变量
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"  # 本地模式默认值 / 远程模式请替换为实际URL

# NextAuth配置
NEXTAUTH_SECRET="[YOUR_NEXTAUTH_SECRET]"
NEXTAUTH_URL="http://localhost:3000"

# 管理员配置
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin123"

# 网站配置
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# logo.dev API Key (可选)
LOGO_DEV_API_KEY="[YOUR_LOGO_DEV_API_KEY]"
